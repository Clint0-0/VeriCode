# Normalise line endings: shell scripts and Python must stay LF even when cloned on Windows (core.autocrlf=true),
# otherwise bash fails with "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.png binary
*.jpg binary
