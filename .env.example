# --- Live search (Track 1, mandatory for live verification) ---
TAVILY_API_KEY=
TAVILY_TIMEOUT=20
TAVILY_MAX_RETRIES=2

# --- LLM provider: anthropic | openai | mock (leave empty to auto-detect from keys) ---
VERICODE_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint (OpenAI, Groq, Together, local vLLM/Ollama gateway, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model ids are never hardcoded: set them here
VERICODE_CODER_MODEL=
VERICODE_PLANNER_MODEL=

VERICODE_LLM_TIMEOUT=180
# Stream coder/repair responses (usage read from stream events)
VERICODE_LLM_STREAM=1
# LLM evidence judge for claims without concrete values (only used with a real provider)
VERICODE_LLM_JUDGE=1
TAVILY_SEARCH_DEPTH=basic

# --- Execution sandbox: auto (docker if reachable) | docker | process ---
VERICODE_SANDBOX=auto
VERICODE_SANDBOX_MEMORY=1g
VERICODE_SANDBOX_CPUS=1

# --- Access control ---
# Fixed login token (default: random per start, printed and written to .vericode_token)
# VERICODE_AUTH_TOKEN=
VERICODE_HOST=127.0.0.1
# Required to bind to anything other than loopback
VERICODE_ALLOW_REMOTE=0

# --- Behaviour ---
# 1 = use the clearly-labelled scripted MOCK provider when no LLM key is set (a configured real provider never falls back)
VERICODE_DEMO_MODE=1
VERICODE_MAX_REPAIRS=3
VERICODE_COMMAND_TIMEOUT=120
VERICODE_CACHE_TTL=86400
# Display-only cost assumptions (USD per million tokens)
VERICODE_COST_IN=3.0
VERICODE_COST_OUT=15.0
# Workspaces the agent may read/modify (default: ./demos)
# VERICODE_WORKSPACES=/abs/path/to/workspaces
# VERICODE_DB=/abs/path/to/vericode.db
