# --- Live search (Track 1, mandatory for live verification) ---
TAVILY_API_KEY=
TAVILY_TIMEOUT=20
TAVILY_MAX_RETRIES=2

# --- LLM provider: anthropic | openai | mock (leave empty to auto-detect from keys) ---
VERICODE_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI-compatible endpoint (OpenAI, Groq, Together, local vLLM/Ollama gateway, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Model ids are never hardcoded: set them here
VERICODE_CODER_MODEL=
VERICODE_PLANNER_MODEL=

# --- Behaviour ---
# 1 = fall back to the clearly-labelled scripted mock provider when no LLM key is set
VERICODE_DEMO_MODE=1
VERICODE_MAX_REPAIRS=3
VERICODE_COMMAND_TIMEOUT=120
VERICODE_CACHE_TTL=86400
# Display-only cost assumptions (USD per million tokens)
VERICODE_COST_IN=3.0
VERICODE_COST_OUT=15.0
# Workspaces the agent may read/modify (default: ./demos)
# VERICODE_WORKSPACES=/abs/path/to/workspaces
# VERICODE_DB=/abs/path/to/vericode.db
